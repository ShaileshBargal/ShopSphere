{
  "name": "shopsphere",
  "version": "1.0.0",
  "description": "ShopSphere - Multi-Vendor MERN Stack E-Commerce Platform",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix backend",
    "client": "npm run dev --prefix frontend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "mern",
    "ecommerce",
    "multivendor",
    "react",
    "node",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC"
}
